{
  "name": "seamer-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm -r typecheck",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "eslint .",
    "dev:link": "pnpm -r --parallel typecheck --watch"
  },
  "dependencies": {
    "@atelier/core": "link:../atelier/packages/core",
    "@atelier/geometry": "link:../atelier/packages/geometry",
    "@atelier/io": "link:../atelier/packages/io",
    "@atelier/sim": "link:../atelier/packages/sim",
    "@atelier/svelte": "link:../atelier/packages/svelte",
    "@atelier/viewport": "link:../atelier/packages/viewport",
    "@seamer/avatar": "workspace:*",
    "@seamer/cloth-sim": "workspace:*",
    "@seamer/pattern-model": "workspace:*",
    "@types/delaunator": "^5.0.3",
    "@webgpu/types": "^0.1.70",
    "better-auth": "^1.0.0",
    "delaunator": "^5.1.0",
    "n8ao": "^1.10.2",
    "three": "0.181.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^25.9.1",
    "@types/three": "0.184.1",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.14",
    "eslint": "^9.39.2",
    "postcss": "^8.4.49",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "license": "MIT"
}
